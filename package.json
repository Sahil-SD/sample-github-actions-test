{
  "name": "api-ui-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run clean && npm run compile",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-tests-chromium",
    "test:api": "playwright test --project=api-tests",
    "test:e2e": "playwright test --project=e2e-tests",
    "test:keyword": "playwright test --project=keyword-tests",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:allure": "allure generate ./allure-results --clean && allure open",
    "clean": "rimraf dist reports logs allure-results storage/auth/*.json",
    "compile": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "generate:data": "ts-node src/data/combinatorial/test-data-sets.ts",
    "report:allure:generate": "npx allure generate  --clean ./reports/allure-results -o ./reports/allure-report",
    "report:allure": "npx allure open ./reports/allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "pom",
    "keyword-driven",
    "data-driven"
  ],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "pino": "^8.17.1",
    "pino-pretty": "^10.3.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "ajv": "^8.17.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.10.2",
    "axios": "^1.20.0",
    "dotenv": "^17.2.1",
    "winston": "^3.17.0"
  }
}
